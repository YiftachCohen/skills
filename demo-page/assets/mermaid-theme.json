  "themeCSS": ".focus > rect, .focus > path, .focus > polygon, .node.focus rect, .node.focus path, .node.focus polygon { stroke: #b0532c !important; stroke-width: 1.75px !important; } .edgeLabel, .labelText, .messageText, .noteText, .taskText, .sectionTitle, .titleText { font-family: \"Hanken Grotesk\", \"Helvetica Neue\", Arial, sans-serif !important; } .edgeLabel, .edgeLabel p, .edgeLabel span { background-color: #f0eee6 !important; } .edgeLabel rect, .labelBkg { fill: #f0eee6 !important; background-color: #f0eee6 !important; opacity: 1 !important; }",
  "flowchart": {
    "curve": "linear",
    "padding": 12,
    "nodeSpacing": 40,
    "rankSpacing": 48,
    "htmlLabels": true
  },
  "sequence": {
    "mirrorActors": false,
    "actorMargin": 56,
    "boxMargin": 8,
    "messageMargin": 32,
    "noteMargin": 10,
    "useMaxWidth": true
  },
  "state": {
    "useMaxWidth": true
  },
  "er": {
    "useMaxWidth": true
  },
  "gantt": {
    "barHeight": 26,
    "barGap": 8,
    "topPadding": 36,
    "leftPadding": 130,
    "fontSize": 14,
    "sectionFontSize": 14,
    "axisFormat": "%b %d",
    "useMaxWidth": true,
    "useWidth": 856
  }
}
